---
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
---

<section id={id} class="mt-10 md:mt-12">
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4 pb-2 border-b border-[var(--color-line)]">
    <h2 class="text-[19px] font-bold tracking-tight" style="color: var(--color-ink)">
      {title}
    </h2>
    <slot name="aside" />
  </header>
  <div>
    <slot />
  </div>
</section>
