---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("portfolio");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const companyName: Record<string, string> = {
  "sionic-ai": "사이오닉AI",
  wrtn: "뤼튼 테크놀로지스",
  kurlypay: "컬리페이",
  marketboro: "마켓보로",
  essays: "Essays",
};

const summarySentences = entry.data.summary
  ? entry.data.summary
      .split(/(?<=\.)\s+/)
      .map((s) => s.replace(/\.$/, "").trim())
      .filter((s) => s.length > 0)
  : [];
---

<Base description={entry.data.summary} printName="최병현_포트폴리오">
  <header class="mb-10">
    <p class="text-[13px] text-[var(--color-ink-subtle)] mb-2">
      {companyName[entry.data.companySlug] ?? entry.data.companySlug}
      {entry.data.period && <span class="ml-2 font-mono">· {entry.data.period}</span>}
    </p>
    <h1 class="text-[30px] md:text-[34px] font-bold leading-[1.25] tracking-tight mb-3">
      {entry.data.title}
    </h1>
    {
      summarySentences.length > 0 && (
        <ul class="text-[15.5px] text-[var(--color-ink-muted)] leading-[1.7] list-disc pl-5 space-y-1">
          {summarySentences.map((s) => (
            <li>{s}</li>
          ))}
        </ul>
      )
    }
  </header>

  <article
    class="prose prose-neutral max-w-none text-[var(--color-ink)]
           prose-headings:tracking-tight prose-headings:font-semibold prose-headings:text-[var(--color-ink)]
           prose-h2:text-[20px] prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-[var(--color-line)]
           prose-h3:text-[17px] prose-h3:mt-8 prose-h3:mb-3
           prose-h4:text-[14px] prose-h4:font-semibold prose-h4:mt-6 prose-h4:mb-2 prose-h4:text-[var(--color-ink-muted)]
           prose-p:text-[15px] prose-p:leading-[1.8] prose-p:text-[var(--color-ink)]
           prose-li:text-[15px] prose-li:leading-[1.75] prose-li:my-1 prose-li:text-[var(--color-ink)]
           marker:text-[var(--color-ink-subtle)]
           prose-a:font-medium prose-a:text-[var(--color-ink)] prose-a:underline prose-a:underline-offset-4 prose-a:decoration-2 prose-a:decoration-[var(--color-ink-subtle)] prose-a:hover:decoration-[var(--color-accent)] prose-a:hover:text-[var(--color-accent)]
           prose-strong:text-[var(--color-ink)] prose-strong:font-semibold
           prose-blockquote:border-l-[3px] prose-blockquote:border-[var(--color-line)] prose-blockquote:pl-4 prose-blockquote:text-[var(--color-ink-muted)] prose-blockquote:not-italic prose-blockquote:font-normal
           prose-code:text-[13.5px] prose-code:text-[var(--color-ink)] prose-code:bg-[var(--color-code-bg)] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
           prose-pre:border-0
           prose-th:text-[var(--color-ink)] prose-td:text-[var(--color-ink)] prose-th:border-[var(--color-line)] prose-td:border-[var(--color-line)]
           prose-img:rounded prose-img:border prose-img:border-[var(--color-line)] prose-img:my-6"
  >
    <Content />
  </article>


  <dialog id="image-modal" class="image-modal">
    <img id="modal-img" alt="" />
  </dialog>

  <script is:inline>
    (function () {
      const dialog = document.getElementById("image-modal");
      const modalImg = document.getElementById("modal-img");
      if (!dialog || !modalImg) return;

      let zoomLevel = 0;
      const setZoom = (lvl) => {
        zoomLevel = lvl;
        if (lvl === 0) {
          modalImg.removeAttribute("data-zoom");
        } else {
          modalImg.setAttribute("data-zoom", String(lvl));
        }
      };

      document.querySelectorAll("article img").forEach((img) => {
        img.style.cursor = "zoom-in";
        img.addEventListener("click", (e) => {
          e.preventDefault();
          modalImg.src = img.currentSrc || img.src;
          modalImg.alt = img.alt || "";
          setZoom(0);
          dialog.showModal();
        });
      });

      // 이미지 클릭 → 단계적 확대 (cycle: 0 → 1 → 2 → 0)
      modalImg.addEventListener("click", (e) => {
        e.stopPropagation();
        setZoom((zoomLevel + 1) % 3);
      });

      // 이미지 밖 (dialog backdrop area) 클릭 → 닫기
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          dialog.close();
          setZoom(0);
        }
      });

      dialog.addEventListener("close", () => setZoom(0));
    })();
  </script>

  <script is:inline>
    // Mermaid 클라이언트 사이드 렌더링
    (function () {
      // Shiki가 language 클래스를 제거하므로, 코드 내용으로 mermaid 블록 감지
      var allPre = document.querySelectorAll('article pre');
      var mermaidPre = [];
      allPre.forEach(function(pre) {
        var code = pre.querySelector('code');
        if (!code) return;
        var text = code.textContent;
        if (/^(---[\s\S]*?---\s*)?(flowchart|sequenceDiagram|graph|classDiagram|stateDiagram|erDiagram|gantt|pie|journey)\b/.test(text)) {
          mermaidPre.push(pre);
        }
      });
      if (mermaidPre.length === 0) return;

      var theme = document.documentElement.classList.contains('dark') ? 'dark' : 'default';

      var script = document.createElement('script');
      script.type = 'module';
      script.textContent = `
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
        mermaid.initialize({
          startOnLoad: false,
          theme: '${theme}',
          themeVariables: ${theme === 'default' ? `{
            background: '#ffffff',
            primaryColor: '#ffffff',
            primaryTextColor: '#111827',
            primaryBorderColor: '#475569',
            lineColor: '#334155',
            edgeLabelBackground: '#ffffff'
          }` : `{
            background: '#0a0a0a',
            primaryColor: '#1a1a1a',
            primaryTextColor: '#ededed',
            primaryBorderColor: '#3a3a3a',
            lineColor: '#6f6f6f',
            edgeLabelBackground: '#0a0a0a'
          }`}
        });

        document.querySelectorAll('article pre').forEach(function(pre, i) {
          var code = pre.querySelector('code');
          if (!code) return;
          var raw = code.textContent;
          if (!/^(---[\\s\\S]*?---\\s*)?(flowchart|sequenceDiagram|graph|classDiagram|stateDiagram|erDiagram|gantt|pie|journey)\\b/.test(raw)) return;
          // frontmatter --- 제거
          raw = raw.replace(/^---[\\s\\S]*?---\\s*/, '');
          var id = 'mermaid-' + i;
          var div = document.createElement('div');
          div.id = id;
          div.className = 'mermaid';
          div.textContent = raw;
          pre.replaceWith(div);
          mermaid.run({ nodes: [div] });
        });
      `;
      document.head.appendChild(script);
    })();
  </script>
</Base>
