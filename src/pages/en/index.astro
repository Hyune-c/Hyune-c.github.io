---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import Experience from "../../components/Experience.astro";
---

<Base printName="Byung_Hyeon_Choi_Resume">
  <header class="mb-8 print:mb-3">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h1 class="text-[30px] md:text-[38px] print:text-[26px] font-bold leading-[1.15] tracking-tight">
        Byung Hyeon Choi
      </h1>
      <span class="text-[16px] font-medium text-[var(--color-ink-muted)]">Backend Developer</span>
    </div>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-2 text-[13.5px] mt-4 print:mt-2">
      <a href="https://github.com/Hyune-c" target="_blank" rel="noopener" title="GitHub (@Hyune-c)"
         class="inline-flex items-center justify-center w-[26px] h-[26px] rounded border border-[var(--color-line)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.58 0-.29-.01-1.04-.02-2.05-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.51.12-3.15 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 3-.4c1.02 0 2.05.13 3 .4 2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.24 2.85.12 3.15.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.37.81 1.1.81 2.22 0 1.6-.01 2.89-.01 3.29 0 .33.22.7.83.58A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/%EB%B3%91%ED%98%84-%EC%B5%9C-b30b971a0/" target="_blank" rel="noopener" title="LinkedIn"
         class="inline-flex items-center justify-center w-[26px] h-[26px] rounded border border-[var(--color-line)] hover:border-[#0A66C2] transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#0A66C2"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:choi8608@gmail.com" class="flex items-center gap-2 group">
        <span class="inline-flex items-center justify-center w-[26px] h-[26px] rounded border border-[var(--color-line)] group-hover:border-[#EA4335] transition-colors flex-shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="11" viewBox="0 0 24 18"><path fill="#EA4335" d="M24 .5v17c0 .276-.224.5-.5.5H20V7.225L12 12.5 4 7.225V18H.5a.5.5 0 0 1-.5-.5V.5C0 .107.37-.164.724.077L12 7.5 23.276.077C23.63-.164 24 .107 24 .5z"/></svg>
        </span>
        <span class="font-medium text-[var(--color-ink)] group-hover:text-[#EA4335] transition-colors">choi8608@gmail.com</span>
      </a>
      <span class="text-[var(--color-line)]">·</span>
      <span class="text-[var(--color-ink-muted)]">Seoul, South Korea</span>
    </div>
  </header>

  <Section title="Summary" id="summary">
    <ul class="space-y-2 print:space-y-1 text-[15px] leading-[1.6] print:leading-[1.45] text-[var(--color-ink)] list-disc pl-5 marker:text-[var(--color-ink-subtle)]">
      <li>
        Backend developer specializing in high-throughput API platforms and AI
        model-serving services, owning products end to end — from design through
        production operations.
      </li>
      <li>
        Built and operate <strong><a href="https://opengateway.ai/" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-2 decoration-[var(--color-ink-subtle)] hover:decoration-[var(--color-accent)] hover:text-[var(--color-accent)]">OpenGateway</a></strong>, an LLM API gateway handling
        280K+ daily calls across 10+ providers; also shipped AI integration and
        payment backends at Wrtn and Kurly Pay.
      </li>
      <li>
        Pragmatic about technology choices, biased toward shipping fast, and
        focused on stabilizing systems in production.
      </li>
    </ul>
  </Section>

  <Section title="Experience" id="experience">
    <p slot="aside" class="text-[14.5px] text-[var(--color-ink-muted)]">
      See full <a href="/en/portfolio/" class="font-medium text-[var(--color-ink)] underline underline-offset-4 decoration-2 decoration-[var(--color-ink-subtle)] hover:decoration-[var(--color-accent)] hover:text-[var(--color-accent)]">portfolio</a>.
    </p>

    <Experience
      company="Sionic AI"
      role="Backend Developer"
      period="2024.09 — Present"
    >
      <ul>
        <li>Built and operate <a href="https://opengateway.ai/" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-2 decoration-[var(--color-ink-subtle)] hover:decoration-[var(--color-accent)] hover:text-[var(--color-accent)]">OpenGateway</a>, an LLM API gateway serving 280K+ daily calls (RPM 200) across 10+ providers and 100+ models, with multi-deployment support.</li>
        <li>Launched Storm Parse as a public API product in two weeks, driving the company's first external SaaS revenue.</li>
        <li>Developed operational tooling and standardized workflows (API Hub, test and back-office tools), improving team productivity.</li>
      </ul>
    </Experience>

    <Experience
      company="Wrtn Technologies"
      role="Backend Developer"
      period="2024.01 — 2024.07"
    >
      <ul>
        <li>Built an AI model-serving service on Spring AI (RPM 750), cutting API response time 20% while improving observability and stability.</li>
        <li>Migrated an existing Node.js service to the JVM with zero downtime.</li>
        <li>Shipped company-wide shared services: tokenizer, email validation, and profanity detection.</li>
      </ul>
    </Experience>

    <Experience
      company="Kurly Pay"
      role="Backend Developer"
      period="2022.09 — 2023.12"
    >
      <ul>
        <li>Led Kurly Pay gift cards from design through operations, including the B2C/B2B bulk-send process.</li>
        <li>Expanded sales channels through partner integrations; supported payment migration and prepaid/points design.</li>
      </ul>
    </Experience>

    <Experience
      company="Earlier Experience"
      role="Backend Developer / SI Development"
    >
      <ul>
        <li>B2B platform development at Marketboro · mobile web, admin, and part-time app development at earlier startups</li>
        <li>SI and IT operations at Kakao Pay, FirstData Korea, and Hana INS</li>
      </ul>
    </Experience>
  </Section>

  <Section title="Education" id="education">
    <ul class="space-y-1.5 text-[14.5px]">
      <li class="grid grid-cols-1 sm:grid-cols-[1fr_auto] sm:items-baseline gap-x-6">
        <span>
          <strong class="font-semibold">Kwangwoon University</strong>
          <span class="text-[var(--color-ink-muted)] ml-2">B.S. in Computer Software, GPA 3.29 / 4.5</span>
        </span>
        <time class="text-[13px] font-mono text-[var(--color-ink-subtle)] tabular-nums">
          2006.03 — 2012.02
        </time>
      </li>
    </ul>
  </Section>

</Base>
