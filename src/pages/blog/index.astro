---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("blog")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date) ||
  b.data.title.localeCompare(a.data.title, "ko", { numeric: true }),
);
---

<Base
  description="백엔드 시스템을 설계하고 운영하며 정리한 기술 기록"
  showLanguageToggle={false}
  disableLanguageAutoRedirect={true}
>
  <header class="mb-10">
    <h1 class="text-[30px] md:text-[34px] font-bold leading-[1.25] tracking-tight">Blog</h1>
  </header>

  <section class="divide-y divide-[var(--color-line)]">
    {entries.map((entry) => (
      <article class="py-7 first:pt-0">
        <a href={`/blog/${entry.id}/`} class="group block">
          <h2 class="text-[20px] font-semibold tracking-tight group-hover:text-[var(--color-accent)] transition-colors">
            {entry.data.title}
            <span class="inline-block ml-2 align-middle text-[12px] font-mono font-normal text-[var(--color-ink-subtle)] group-hover:text-[var(--color-accent)]">
              {entry.data.date}
            </span>
          </h2>
          <p class="text-[15px] leading-[1.75] text-[var(--color-ink-muted)] mt-2">{entry.data.summary}</p>
        </a>
      </article>
    ))}
  </section>
</Base>
